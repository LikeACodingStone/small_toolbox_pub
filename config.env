# 2D -> 3D Half-SBS H.265/HEVC conversion config
#
# Usage:
#   1) Edit INPUT_FOLDER and OUTPUT_FOLDER.
#   2) Run: bash run_2d_to_3d_av1.sh

# Input / output
INPUT_FOLDER="./InputFolder"
OUTPUT_FOLDER="./OutputFolder"
# H.265 outputs use a distinct name, so completed AV1 outputs are retained.
OUTPUT_TAG="_3D_H265"
# 0 skips completed outputs so a stopped batch can be resumed; 1 replaces them.
OVERWRITE_EXISTING=0
# 1 keeps each existing 3D video stream but refreshes its audio/subtitle streams
# from the source, then verifies copied audio packets. It does not run the model.
REPAIR_EXISTING_AUDIO=0
WORK_DIR="./work_2d_to_3d"
LOG_DIR="./logs"

# Decoded/generated frames are streamed through memory and are never stored.
# This is a safety guard for any unexpected files created in a run work folder.
MAX_WORK_GB=200

# Keep the output canvas equal to the source canvas. For a 4K input this is
# 3840x2160 Half-SBS (left 1920x2160 + right 1920x2160). Lower-resolution
# sources are not pointlessly upscaled, while higher-resolution sources are
# not silently downscaled. Explicit even dimensions are still supported.
OUTPUT_WIDTH="source"
OUTPUT_HEIGHT="source"

# Depth model. Depth Anything V2 small is faster for first tests.
# Other examples:
#   depth-anything/Depth-Anything-V2-Base-hf
#   depth-anything/Depth-Anything-V2-Large-hf
DEPTH_MODEL="depth-anything/Depth-Anything-V2-Small-hf"

# Use GPU for depth inference when ROCm/PyTorch is available.
# ROCm exposes AMD GPUs through torch's "cuda" device name.
DEVICE="cuda"

# 3D strength. Conservative value minimizes foreground edge tearing and makes
# faces/people easier to fuse. Raise to 18-20 only after a short test looks clean.
MAX_DISPARITY=16
DEPTH_GAMMA=1.25
CONVERGENCE=0.50
# Edge-guided depth refinement keeps depth transitions on animal/person
# silhouettes, reducing halos and eye-straining double edges.
DEPTH_EDGE_RADIUS=6
DEPTH_EDGE_EPSILON=0.0005
# Blend the synthesized eye back toward the source only around hard disparity
# edges. This sacrifices a little stereo strength at silhouettes to remove the
# distracting person/animal outline fringes that are hardest to fuse.
OCCLUSION_EDGE_BLEND=0.55
OCCLUSION_EDGE_WIDTH=3
OCCLUSION_EDGE_THRESHOLD=1.0
# Stabilize the per-frame depth scale without blending depth maps (which would
# leave trails on moving subjects). Scene cuts reset the stabilizer immediately.
DEPTH_TEMPORAL_RESPONSE=0.12
SCENE_CUT_THRESHOLD=0.18
# Keep the left eye as an undistorted anchor and synthesize only the right eye.
# This preserves one fully sharp view and reduces binocular edge discomfort.
STEREO_WARP_MODE="anchored"

# Test mode: set to a positive number to process only the first N seconds.
# Empty means full movie.
TEST_SECONDS=

# Preserve the input's exact rational frame rate. Set an explicit value such as
# "24000/1001" only when a delivery specification requires conversion.
OUTPUT_FPS="source"
# Keep the actual video as left/right Half-SBS, but do not write Matroska
# stereo_mode metadata by default. PotPlayer may auto-interpret that metadata
# and present the file as a flattened 2D-looking view during normal playback.
# Set this to "left_right" only when you want player/TV auto-detection.
STEREO_MODE=""

# High-fidelity H.265/HEVC settings. "source" selects the source video stream
# bitrate, preserving the input's rate budget without forcing a needlessly high
# CBR output. SOURCE_BITRATE_MULTIPLIER=1.00 means exactly the source bitrate.
# If the input has no usable bitrate metadata, CRF is used as a safe fallback.
VIDEO_BITRATE="source"
SOURCE_BITRATE_MULTIPLIER=1.00
RATE_CONTROL="vbr"
H265_CRF=16
H265_PRESET="slow"
# Adaptive quantization and psychovisual tuning preserve fine texture in the
# generated stereo view. HDR color metadata is added automatically per source.
H265_PARAMS="aq-mode=3:aq-strength=0.8:psy-rd=2.0:psy-rdoq=1.0:strong-intra-smoothing=0:repeat-headers=1"

# Copy every source audio stream by default. This preserves TrueHD/DTS and
# additional tracks. Set AUDIO_CODEC (for example libopus) to re-encode.
AUDIO_CODEC="copy"
AUDIO_BITRATE="192k"
# 0 preserves each source stream's channel layout when audio is re-encoded.
AUDIO_CHANNELS=0

# CPU usage for ffmpeg/x265. 0 means auto.
FFMPEG_THREADS=0
# Quality-neutral pipeline buffering. Keeps depth/stereo generation overlapped
# with x265 stdin writes. Each queued 3840x1600 bgr48le frame is about 35 MiB.
ENCODER_QUEUE_FRAMES=2
# Depth Anything batching. 4 improves GPU utilization on the RX 7800 XT without
# changing the model or the output settings.
DEPTH_BATCH_FRAMES=4

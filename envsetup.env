# Environment bootstrap for 3DMovie run scripts.
# Sourced automatically by run_2d_to_3d_av1.sh before config.env.

SYSTEM_PATH="$(getconf PATH 2>/dev/null || printf '%s' '/bin:/usr/bin')"
export PATH="$SYSTEM_PATH${PATH:+:$PATH}"

hash -r 2>/dev/null || true

# Keep the ROCm/PyTorch choice in one place so the runner and diagnostics use
# the same wheel index.
ROCM_TORCH_VERSION="${ROCM_TORCH_VERSION:-6.4}"
ROCM_TORCH_INDEX_URL="${ROCM_TORCH_INDEX_URL:-https://download.pytorch.org/whl/rocm${ROCM_TORCH_VERSION}}"
TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL="${TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL:-1}"
export TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL

envsetup_check_rocm() {
    echo "[INFO] ROCm tools"
    if command -v rocm-smi >/dev/null 2>&1; then
        rocm-smi --showproductname --showmeminfo vram || true
    else
        echo "[WARN] rocm-smi not found; PyTorch may still work if ROCm libraries are available."
    fi

    if [[ -e /dev/kfd ]]; then
        if [[ -r /dev/kfd && -w /dev/kfd ]]; then
            echo "[OK] /dev/kfd is accessible"
        else
            echo "[WARN] /dev/kfd is not accessible; the current session may need the render group."
        fi
    else
        echo "[WARN] /dev/kfd not found; ROCm GPU access is unavailable."
    fi
}

envsetup_probe_torch_gpu() {
    local python_bin="$1"

    "$python_bin" - <<'PY'
try:
    import torch
except Exception as exc:
    print(f"torch import failed: {exc}")
    raise SystemExit(2)

hip_version = getattr(torch.version, "hip", None)
cuda_version = getattr(torch.version, "cuda", None)
cuda_available = torch.cuda.is_available()

print(f"torch: {torch.__version__}")
print(f"torch.version.hip: {hip_version}")
print(f"torch.version.cuda: {cuda_version}")
print(f"cuda/rocm available: {cuda_available}")
if cuda_available:
    print(f"gpu: {torch.cuda.get_device_name(0)}")
    raise SystemExit(0)
raise SystemExit(1)
PY
}

envsetup_prepare_python() {
    local venv_dir="$1"
    local python_bin="$venv_dir/bin/python3"
    local probe_output
    local probe_status

    if [[ ! -d "$venv_dir" ]]; then
        python3 -m venv "$venv_dir"
        echo "[OK] Created venv: $venv_dir"
    else
        echo "[OK] Using existing venv: $venv_dir"
    fi

    [[ -x "$python_bin" ]] || {
        echo "[ERROR] venv Python not found: $python_bin" >&2
        return 1
    }

    # Use absolute paths in callers, but also expose the prepared venv to any
    # helper process launched during setup.
    source "$venv_dir/bin/activate"
    "$python_bin" -m pip install --upgrade pip setuptools wheel
    "$python_bin" -m pip install numpy pillow opencv-python tqdm transformers accelerate safetensors

    if probe_output="$(envsetup_probe_torch_gpu "$python_bin")"; then
        printf '%s\n' "$probe_output"
        return 0
    else
        probe_status=$?
    fi

    printf '%s\n' "$probe_output"
    if [[ "$probe_status" -eq 2 ]]; then
        echo "[WARN] PyTorch is missing or broken. Installing ROCm PyTorch wheels."
    else
        echo "[WARN] PyTorch is installed, but GPU is not available. Installing ROCm PyTorch wheels."
    fi

    if ! "$python_bin" -m pip install --upgrade --force-reinstall torch torchvision --index-url "$ROCM_TORCH_INDEX_URL"; then
        echo "[WARN] ROCm PyTorch wheel installation failed; keeping the current torch build."
    fi

    if probe_output="$(envsetup_probe_torch_gpu "$python_bin")"; then
        printf '%s\n' "$probe_output"
        return 0
    else
        probe_status=$?
    fi

    printf '%s\n' "$probe_output"
    echo "[WARN] GPU still unavailable after reinstall (exit $probe_status). The converter will fall back to CPU until the ROCm stack is fixed."
    return 1
}

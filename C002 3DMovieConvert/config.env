# 2D -> 3D Half-SBS AV1 conversion config
#
# Usage:
#   1) Edit INPUT_FOLDER and OUTPUT_FOLDER.
#   2) Run: bash run_2d_to_3d_av1.sh

# Input / output
INPUT_FOLDER="."
OUTPUT_FOLDER="./output_3d"
# 0 skips completed outputs so a stopped batch can be resumed; 1 replaces them.
OVERWRITE_EXISTING=0
WORK_DIR="./work_2d_to_3d"
LOG_DIR="./logs"

# Decoded/generated frames are streamed through memory and are never stored.
# This is a safety guard for any unexpected files created in a run work folder.
MAX_WORK_GB=200

# Output format: 4K Half-SBS = left 1920x2160 + right 1920x2160
OUTPUT_WIDTH=3840
OUTPUT_HEIGHT=2160

# Depth model. Depth Anything V2 small is faster for first tests.
# Other examples:
#   depth-anything/Depth-Anything-V2-Base-hf
#   depth-anything/Depth-Anything-V2-Large-hf
DEPTH_MODEL="depth-anything/Depth-Anything-V2-Small-hf"

# Use GPU for depth inference when ROCm/PyTorch is available.
# ROCm exposes AMD GPUs through torch's "cuda" device name.
DEVICE="cuda"

# 3D strength. Start low; too much parallax causes eye strain and edge artifacts.
MAX_DISPARITY=36
DEPTH_GAMMA=1.25
CONVERGENCE=0.52

# Test mode: set to a positive number to process only the first N seconds.
# Empty means full movie.
TEST_SECONDS=

# AV1 encode settings. CPU SVT-AV1 gives better compression than AMD hardware AV1.
AV1_CRF=18
AV1_PRESET=5
AUDIO_CODEC="libopus"
AUDIO_BITRATE="192k"
# 2 avoids libopus failing on DTS 5.1(side). Use 0 only when not re-encoding audio.
AUDIO_CHANNELS=2

# CPU usage for ffmpeg/SVT-AV1. 0 means auto.
FFMPEG_THREADS=0

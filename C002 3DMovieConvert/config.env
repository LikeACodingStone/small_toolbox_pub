# 输入/输出。也可以在命令行传入视频路径覆盖 INPUT_VIDEO。
INPUT_VIDEO=""
OUTPUT_DIR="./output"

# AV1 质量：CRF 20.0 写作 20。范围 0-63，越小画质越高、体积越大。
CRF=20
PRESET=5
AV1_ENCODER="libsvtav1"

# 4K Half-SBS：左右眼各 1920x2160，合成后 3840x2160。
REQUIRED_INPUT_WIDTH=3840
REQUIRED_INPUT_HEIGHT=2160
EYE_WIDTH=1920
EYE_HEIGHT=2160

# 伪立体水平视差（源视频像素）。数值过大会造成眼睛疲劳，建议 12-32。
EYE_SHIFT=24

# 0 表示由 FFmpeg/SVT-AV1 自动使用全部 CPU 线程。
THREADS=0

# copy 保留原音频；也可设置 opus 或 aac。
AUDIO_MODE="copy"
OVERWRITE=false

